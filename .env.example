# Choose the translation backend. Default is the original MADLAD.
TRANSLATION_PROVIDER=madlad

# MADLAD settings
MODEL_NAME=google/madlad400-3b-mt
TARGET_LANGUAGE=th
DEVICE=auto
MAX_INPUT_TOKENS=1024
MAX_NEW_TOKENS=512
NUM_BEAMS=4
MAX_BATCH_SIZE=8
MAX_CONCURRENT_INFERENCE=1

# Experimental Qwen mode, calling Ollama on the host from Docker Desktop
QWEN_MODEL=qwen3.5:4b
QWEN_BASE_URL=http://host.docker.internal:11434
# If FastAPI runs outside Docker, use http://localhost:11434 instead
QWEN_TIMEOUT_SECONDS=180
QWEN_TEMPERATURE=0.1
QWEN_CONTEXT_TOKENS=4096
QWEN_MAX_INPUT_CHARS=8000
